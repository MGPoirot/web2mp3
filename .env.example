# web2mp3 configuration. Copy this file to `.env` and fill in the real
# values -- this is the only config file you need.

# Absolute host path to your music library (e.g. a Plex NAS mount).
# This gets bind-mounted to /music inside the container.
HOST_MUSIC_DIR=/path/to/your/Music

# UID/GID the container process runs as, applied at container startup
# (no rebuild needed to change these). Match them to whatever user/group
# owns HOST_MUSIC_DIR on the host so downloaded files are writable/readable
# as expected. Check with `id -u` / `id -g`, or
# `stat -c '%u %g' /path/to/your/Music`.
PUID=1000
PGID=1000

# Spotify Developer credentials: https://developer.spotify.com/dashboard
# Required -- there's no sensible default for these. Once you have an app,
# add SPOTIPY_REDIRECT_URI below (or the default, https://maartenpoirot.com/contact)
# as an allowed Redirect URI in the app's settings, or Spotify login will fail.
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=

# Spotify API market / your country code, e.g. NL, US.
# Optional -- falls back to US (with a console notice) if omitted.
# LOCATION=US

# Only needed if you'd rather register your own Redirect URI in the
# Spotify app's settings instead of the default above.
# SPOTIPY_REDIRECT_URI=https://maartenpoirot.com/contact

# Optional web GUI (paste a URL into a page instead of using `dl`).
# Set to false to disable it entirely -- the container just idles as before,
# and dl/cookie/inspect via `docker exec` are unaffected either way.
# GUI_ENABLED=true
# GUI_PORT=4546

# Optional shared-secret gate for the GUI. Unset (default) = no auth at all,
# fine for LAN-only use. Set it to require this password (HTTP Basic Auth)
# for every GUI request, including the WebSocket connection.
# GUI_PASSWORD=
