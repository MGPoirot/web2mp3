# docker-compose configuration.
# Copy this file to `.env` and fill in the real values.

# Absolute host path to your music library (e.g. a Plex NAS mount).
# This gets bind-mounted to /music inside the container.
HOST_MUSIC_DIR=/path/to/your/Music

# UID/GID the container process runs as. Match these to whatever
# user/group owns HOST_MUSIC_DIR on the host so downloaded files are
# writable/readable as expected. Check with `id -u` / `id -g`, or
# `stat -c '%u %g' /path/to/your/Music`.
UID=1000
GID=1000
