#!/bin/sh
# Run download DAEMONs directly, without going through the `dl` matcher.
# Mainly useful with --verbose, to watch a download/tag run happen in the
# foreground instead of reading .logs after the fact.
#
# `docker exec` bypasses ENTRYPOINT and defaults to root, since the image has
# no static USER (it's remapped to PUID/PGID at container start instead) —
# drop to that same unprivileged, correctly-owned user before running.
#
# Usage:
#   docker compose exec web2mp3 daemon --verbose
#   docker compose exec web2mp3 daemon --verbose --continuous
#   docker compose exec web2mp3 daemon --verbose --continuous -t 0
exec setpriv --reuid "${PUID:-1000}" --regid "${PGID:-1000}" --clear-groups python src/download_daemon.py "$@"
